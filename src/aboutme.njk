                        <script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.183.0/build/three.module.js"}}</script>
                        <script type="module">
                        import * as THREE from 'three';

                        (function() {
                            /* ── Config ── */
                            const SPHERE_RADIUS = 1.8;
                            const DOT_COUNT = 2800;
                            const DOT_SIZE = 0.022;
                            const MARKER_SIZE_BASE = 0.045;
                            const AUTO_ROTATE_SPEED = 0.09;
                            const CAMERA_POS = [0, 0, 5.5];
                            const CAMERA_FOV = 45;

                            const markers = [
                                { lng: 133.7, lat: -25.3, name: "Australia",       color: "#00ff88" },
                                { lng: 14.6,  lat: 47.5,  name: "Austria",         color: "#22d3ee" },
                                { lng:-106.3, lat: 56.1,  name: "Canada",          color: "#f59e0b" },
                                { lng: 104.2, lat: 35.9,  name: "China",           color: "#ff00ff" },
                                { lng: 2.2,   lat: 46.6,  name: "France",          color: "#6366f1" },
                                { lng: 10.5,  lat: 51.2,  name: "Germany",         color: "#00ff88" },
                                { lng: 21.8,  lat: 39.1,  name: "Greece",          color: "#22d3ee" },
                                { lng: 113.9, lat: -0.8,  name: "Indonesia",       color: "#f59e0b" },
                                { lng: 12.6,  lat: 41.9,  name: "Italy",           color: "#ff00ff" },
                                { lng: 138.3, lat: 36.2,  name: "Japan",           color: "#6366f1" },
                                { lng: 101.7, lat: 4.2,   name: "Malaysia",        color: "#00ff88" },
                                { lng: 5.3,   lat: 52.1,  name: "Netherlands",     color: "#22d3ee" },
                                { lng: 174.9, lat:-40.9,  name: "New Zealand",     color: "#f59e0b" },
                                { lng: -8.2,  lat: 39.4,  name: "Portugal",        color: "#ff00ff" },
                                { lng: 24.7,  lat:-28.5,  name: "South Africa",    color: "#6366f1" },
                                { lng: 8.2,   lat: 46.8,  name: "Switzerland",     color: "#00ff88" },
                                { lng: -3.4,  lat: 55.4,  name: "United Kingdom",  color: "#22d3ee" },
                                { lng:-95.7,  lat: 37.1,  name: "United States",   color: "#f59e0b" },
                                { lng: 108.3, lat: 14.1,  name: "Vietnam",         color: "#ff00ff" },
                                { lng:-81.3,  lat: 19.3,  name: "Cayman Islands",  color: "#6366f1" },
                            ];

                            /* ── Scene setup ── */
                            const container = document.getElementById('globe-container');
                            const tooltip = document.getElementById('globe-tooltip');
                            const counterEl = document.getElementById('globe-counter');

                            const scene = new THREE.Scene();
                            const camera = new THREE.PerspectiveCamera(CAMERA_FOV, 1, 0.1, 100);
                            camera.position.set(...CAMERA_POS);

                            const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
                            renderer.setClearColor(0x000000, 0);
                            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
                            container.insertBefore(renderer.domElement, container.firstChild);
                            renderer.domElement.style.display = 'block';
                            renderer.domElement.style.width = '100%';
                            renderer.domElement.style.height = '100%';
                            renderer.domElement.style.cursor = 'grab';

                            // Lights (matching ausdata.ai)
                            const ambient = new THREE.AmbientLight(0xffffff, 0.18);
                            scene.add(ambient);
                            const dirLight = new THREE.DirectionalLight(0xffffff, 2.2);
                            dirLight.position.set(4, 6, 5);
                            scene.add(dirLight);
                            const fillLight = new THREE.DirectionalLight(0x8888ff, 0.25);
                            fillLight.position.set(-3, -2, -3);
                            scene.add(fillLight);

                            /* ── Fibonacci dot sphere (background particles) ── */
                            const dotGroup = new THREE.Group();
                            scene.add(dotGroup);

                            const positions = new Float32Array(3 * DOT_COUNT);
                            const sizes = new Float32Array(DOT_COUNT);
                            const goldenAngle = Math.PI * (3 - Math.sqrt(5));

                            for (let i = 0; i < DOT_COUNT; i++) {
                                const y = 1 - (i / (DOT_COUNT - 1)) * 2;
                                const radiusAtY = Math.sqrt(1 - y * y);
                                const theta = goldenAngle * i;
                                positions[3 * i]     = Math.cos(theta) * radiusAtY * SPHERE_RADIUS;
                                positions[3 * i + 1] = y * SPHERE_RADIUS;
                                positions[3 * i + 2] = Math.sin(theta) * radiusAtY * SPHERE_RADIUS;
                                sizes[i] = 0.012 + 0.018 * Math.random();
                            }

                            const dotGeo = new THREE.BufferGeometry();
                            dotGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
                            dotGeo.setAttribute('size', new THREE.BufferAttribute(sizes, 1));
                            const dotMat = new THREE.PointsMaterial({
                                color: 0xffffff,
                                size: DOT_SIZE,
                                sizeAttenuation: true,
                                transparent: true,
                                opacity: 0.82,
                                depthWrite: false,
                            });
                            const dotPoints = new THREE.Points(dotGeo, dotMat);
                            dotGroup.add(dotPoints);

                            /* ── Rotation state (quaternion-based, matching ausdata.ai) ── */
                            const rotationQ = new THREE.Quaternion();
                            const identityQ = new THREE.Quaternion();
                            const yAxis = new THREE.Vector3(0, 1, 0);
                            const xAxis = new THREE.Vector3(1, 0, 0);
                            const tempQ = new THREE.Quaternion();

                            const drag = { active: false, deltaQ: new THREE.Quaternion(), lastVec: new THREE.Vector3() };
                            const mouseVel = { vx: 0, vy: 0 };
                            let lastMouse = null;
                            let mouseDecayTimer = null;
                            let elapsedTime = 0;

                            function trackballVec(x, y) {
                                const r = Math.sqrt(x * x + y * y);
                                const z = r < 0.8 ? Math.sqrt(0.8 * 0.8 - r * r) : (0.8 * 0.8) / (2 * r);
                                return new THREE.Vector3(x, y, z).normalize();
                            }

                            /* ── Country markers as glowing orbs ── */
                            const markerGroup = new THREE.Group();
                            scene.add(markerGroup);

                            const markerMeshes = [];
                            const hitMeshes = [];

                            function latLngToVec3(lat, lng, radius) {
                                const phi = (90 - lat) * Math.PI / 180;
                                const theta = (lng + 180) * Math.PI / 180;
                                return new THREE.Vector3(
                                    -radius * Math.sin(phi) * Math.cos(theta),
                                    radius * Math.cos(phi),
                                    radius * Math.sin(phi) * Math.sin(theta)
                                );
                            }

                            markers.forEach((m, i) => {
                                const pos = latLngToVec3(m.lat, m.lng, SPHERE_RADIUS);
                                const color = new THREE.Color(m.color);
                                const group = new THREE.Group();
                                group.position.copy(pos);

                                // Spoke line from center to orb
                                const spokeGeo = new THREE.BufferGeometry();
                                spokeGeo.setAttribute('position', new THREE.BufferAttribute(
                                    new Float32Array([pos.x, pos.y, pos.z, 0, 0, 0]), 3
                                ));
                                const spokeMat = new THREE.LineBasicMaterial({
                                    color: color, transparent: true, opacity: 0.28
                                });
                                const spoke = new THREE.LineSegments(spokeGeo, spokeMat);
                                markerGroup.add(spoke);

                                // Outer glow sphere
                                const glowOuter = new THREE.Mesh(
                                    new THREE.SphereGeometry(2.8 * MARKER_SIZE_BASE, 16, 16),
                                    new THREE.MeshBasicMaterial({ color: color, transparent: true, opacity: 0.055, depthWrite: false })
                                );
                                group.add(glowOuter);

                                // Inner glow sphere
                                const glowInner = new THREE.Mesh(
                                    new THREE.SphereGeometry(1.55 * MARKER_SIZE_BASE, 16, 16),
                                    new THREE.MeshBasicMaterial({ color: color, transparent: true, opacity: 0.14, depthWrite: false })
                                );
                                group.add(glowInner);

                                // Core orb
                                const core = new THREE.Mesh(
                                    new THREE.SphereGeometry(MARKER_SIZE_BASE, 48, 48),
                                    new THREE.MeshStandardMaterial({
                                        color: color, roughness: 0.3, metalness: 0.55,
                                        emissive: color, emissiveIntensity: 0.12,
                                    })
                                );
                                group.add(core);

                                // Invisible hit target (for raycasting)
                                const hit = new THREE.Mesh(
                                    new THREE.SphereGeometry(Math.max(4 * MARKER_SIZE_BASE, 0.18), 8, 8),
                                    new THREE.MeshBasicMaterial({ transparent: true, opacity: 0, depthWrite: false })
                                );
                                hit.visible = false;
                                group.add(hit);

                                markerGroup.add(group);
                                markerMeshes.push({ group, core, glowInner, glowOuter, spoke, data: m, targetScale: 1 });
                                hitMeshes.push(hit);
                            });

                            /* ── Raycaster for hover detection ── */
                            const raycaster = new THREE.Raycaster();
                            const mouseNDC = new THREE.Vector2(-99, -99);
                            let hoveredIdx = null;

                            renderer.domElement.addEventListener('mousemove', e => {
                                const rect = renderer.domElement.getBoundingClientRect();
                                mouseNDC.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
                                mouseNDC.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
                            });

                            /* ── Pointer drag interaction (quaternion trackball) ── */
                            let pointerStart = null;

                            renderer.domElement.addEventListener('pointerdown', e => {
                                drag.active = true;
                                drag.deltaQ.identity();
                                pointerStart = { x: e.clientX, y: e.clientY };
                                const rect = renderer.domElement.getBoundingClientRect();
                                const nx = ((e.clientX - rect.left) / rect.width) * 2 - 1;
                                const ny = -((e.clientY - rect.top) / rect.height) * 2 + 1;
                                drag.lastVec.copy(trackballVec(nx, ny));
                                renderer.domElement.setPointerCapture(e.pointerId);
                                renderer.domElement.style.cursor = 'grabbing';
                            });

                            renderer.domElement.addEventListener('pointermove', e => {
                                if (!drag.active) return;
                                const rect = renderer.domElement.getBoundingClientRect();
                                const nx = ((e.clientX - rect.left) / rect.width) * 2 - 1;
                                const ny = -((e.clientY - rect.top) / rect.height) * 2 + 1;
                                const newVec = trackballVec(nx, ny);
                                drag.deltaQ.setFromUnitVectors(drag.lastVec, newVec);
                                drag.lastVec.copy(newVec);
                            });

                            renderer.domElement.addEventListener('pointerup', e => {
                                drag.active = false;
                                renderer.domElement.style.cursor = 'grab';
                                // Check if it was a click (not a drag) on a marker
                                if (pointerStart) {
                                    const dx = e.clientX - pointerStart.x;
                                    const dy = e.clientY - pointerStart.y;
                                    if (Math.sqrt(dx*dx + dy*dy) < 6 && hoveredIdx !== null) {
                                        // Could open link or do something on click
                                    }
                                }
                                pointerStart = null;
                            });

                            renderer.domElement.addEventListener('pointerleave', () => {
                                drag.active = false;
                                renderer.domElement.style.cursor = 'grab';
                            });

                            /* ── Mouse velocity tracking (outside globe = nudge rotation) ── */
                            window.addEventListener('mousemove', e => {
                                const rect = renderer.domElement.getBoundingClientRect();
                                // Only track velocity when mouse is outside the canvas
                                if (e.clientX >= rect.left && e.clientX <= rect.right &&
                                    e.clientY >= rect.top && e.clientY <= rect.bottom) {
                                    mouseVel.vx = 0; mouseVel.vy = 0; lastMouse = null;
                                    if (mouseDecayTimer) clearTimeout(mouseDecayTimer);
                                    return;
                                }
                                const cx = rect.left + rect.width / 2;
                                const cy = rect.top + rect.height / 2;
                                const halfW = rect.width / 2;
                                const sx = (e.clientX - cx) / halfW;
                                const sy = -(e.clientY - cy) / halfW;
                                if (lastMouse) {
                                    const dx = Math.max(-0.02, Math.min(0.02, sx - lastMouse.x));
                                    const dy = Math.max(-0.02, Math.min(0.02, sy - lastMouse.y));
                                    mouseVel.vx = 0.3 * dx + 0.7 * mouseVel.vx;
                                    mouseVel.vy = 0.3 * dy + 0.7 * mouseVel.vy;
                                }
                                lastMouse = { x: sx, y: sy };
                                if (mouseDecayTimer) clearTimeout(mouseDecayTimer);
                                mouseDecayTimer = setTimeout(() => { mouseVel.vx = 0; mouseVel.vy = 0; lastMouse = null; }, 2000);
                            });

                            /* ── Resize handling ── */
                            function resize() {
                                const w = container.clientWidth;
                                const h = container.clientHeight || w;
                                renderer.setSize(w, h);
                                camera.aspect = w / h;
                                camera.updateProjectionMatrix();
                            }
                            resize();
                            window.addEventListener('resize', resize);

                            /* ── Atmosphere glow (CSS overlay, matching ausdata.ai) ── */
                            const glowDiv = document.createElement('div');
                            glowDiv.setAttribute('aria-hidden', 'true');
                            glowDiv.style.cssText = `position:absolute;inset:0;border-radius:50%;pointer-events:none;
                                background:radial-gradient(ellipse at 50% 50%, rgba(34,211,238,0.08) 0%, transparent 70%);`;
                            container.appendChild(glowDiv);



                            /* ── Counter ── */
                            counterEl.textContent = markers.length + ' countries visited';

                            /* ── Theme handling ── */
                            function updateTheme() {
                                const isLight = document.documentElement.getAttribute('data-theme') === 'light';
                                dotMat.color.set(isLight ? 0x111111 : 0xffffff);
                                dotMat.opacity = isLight ? 0.75 : 0.82;
                                ambient.intensity = isLight ? 0.35 : 0.18;
                                dirLight.intensity = isLight ? 1.8 : 2.2;
                                glowDiv.style.background = isLight
                                    ? 'radial-gradient(ellipse at 50% 50%, rgba(99,102,241,0.07) 0%, transparent 70%)'
                                    : 'radial-gradient(ellipse at 50% 50%, rgba(34,211,238,0.08) 0%, transparent 70%)';

                                markerMeshes.forEach(m => {
                                    m.glowInner.material.opacity = isLight ? 0.1 : 0.14;
                                    m.glowOuter.material.opacity = isLight ? 0.04 : 0.055;
                                    m.spoke.material.opacity = isLight ? 0.22 : 0.28;
                                });
                            }
                            new MutationObserver(updateTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

                            /* ── Animation loop ── */
                            const clock = new THREE.Clock();
                            const euler = new THREE.Euler();

                            function animate() {
                                requestAnimationFrame(animate);
                                const dt = clock.getDelta();
                                elapsedTime += dt;

                                /* Rotation update (matching ausdata.ai quaternion logic) */
                                if (drag.active) {
                                    rotationQ.premultiply(drag.deltaQ);
                                } else {
                                    // Decay drag delta
                                    drag.deltaQ.slerp(identityQ, 0.08);
                                    rotationQ.premultiply(drag.deltaQ);

                                    // Mouse velocity nudge
                                    if (Math.abs(mouseVel.vx) > 1e-4 || Math.abs(mouseVel.vy) > 1e-4) {
                                        tempQ.setFromAxisAngle(yAxis, 1.8 * mouseVel.vx);
                                        rotationQ.premultiply(tempQ);
                                        tempQ.setFromAxisAngle(xAxis, -(1.8 * mouseVel.vy));
                                        rotationQ.premultiply(tempQ);
                                    }

                                    // Auto-rotate
                                    tempQ.setFromAxisAngle(yAxis, AUTO_ROTATE_SPEED * dt);
                                    rotationQ.premultiply(tempQ);

                                    // Gentle pitch correction (same as ausdata.ai)
                                    euler.setFromQuaternion(rotationQ, 'YXZ');
                                    const pitchCorrect = (0.18 * Math.sin(0.12 * elapsedTime) - euler.x) * 0.02;
                                    tempQ.setFromAxisAngle(xAxis, pitchCorrect);
                                    rotationQ.premultiply(tempQ);
                                }
                                rotationQ.normalize();
                                dotGroup.quaternion.copy(rotationQ);
                                markerGroup.quaternion.copy(rotationQ);

                                /* Camera drift (subtle mouse follow) */
                                camera.position.x += (0.5 * mouseNDC.x - camera.position.x) * 0.04;
                                camera.position.y += (0.2 * mouseNDC.y - camera.position.y) * 0.04;
                                camera.lookAt(0, 0, 0);

                                /* Raycast for marker hover */
                                raycaster.setFromCamera(mouseNDC, camera);
                                const visible = hitMeshes.map(h => { h.visible = true; return h; });
                                const hits = raycaster.intersectObjects(visible);
                                visible.forEach(h => h.visible = false);

                                let newHovered = null;
                                if (hits.length > 0) {
                                    const idx = hitMeshes.indexOf(hits[0].object);
                                    if (idx >= 0) newHovered = idx;
                                }

                                if (newHovered !== hoveredIdx) {
                                    hoveredIdx = newHovered;
                                    if (hoveredIdx !== null) {
                                        const m = markerMeshes[hoveredIdx];
                                        const worldPos = new THREE.Vector3();
                                        m.core.getWorldPosition(worldPos);
                                        const screenPos = worldPos.clone().project(camera);
                                        const rect = renderer.domElement.getBoundingClientRect();
                                        tooltip.textContent = m.data.name;
                                        tooltip.style.borderColor = m.data.color + '55';
                                        tooltip.style.left = ((screenPos.x + 1) / 2 * rect.width) + 'px';
                                        tooltip.style.top = ((-screenPos.y + 1) / 2 * rect.height) + 'px';
                                        tooltip.style.opacity = '1';
                                    } else {
                                        tooltip.style.opacity = '0';
                                    }
                                }

                                renderer.domElement.style.cursor = hoveredIdx !== null ? 'pointer' : (drag.active ? 'grabbing' : 'grab');

                                /* Marker hover scale animation */
                                markerMeshes.forEach((m, i) => {
                                    const target = (i === hoveredIdx) ? 1.8 : 1;
                                    const current = m.core.scale.x;
                                    const s = current + (target - current) * 0.15;
                                    m.core.scale.setScalar(s);
                                    m.glowInner.scale.setScalar(s);
                                });

                                renderer.render(scene, camera);
                            }
                            animate();
                        })();
                        </script>


                        <section id="books">
                            <h2 class="mb-3 mt-5 mb-3">📖 Books</h2>
                        </section>
                        <p>Here are my top 5 books that I would recommend. </p>

                        <ul>

                            <li> <b><a href="https://www.amazon.com/Adam-Smith-Change-Your-Life/dp/1591847958"
                                        target="_blank"> <i>How Adam Smith Can Change Your Life</i></a> by Russ
                                    Roberts</b> - Many people know the Wealth of Nations, but 16 years earlier Adam
                                smith wrote the Theory of Moral Sentiments because he believed that before he could
                                understand economics, he had to understand people. Love this book and it is amazing how
                                timeless it is.
                            </li>

                            <li> <b><a href="https://www.amazon.com/Thinking-Fast-Slow-Daniel-Kahneman-ebook/dp/B00555X8OA"
                                        target="_blank"> <i>Thinking Fast and Slow</i></a> by Daniel
                                    Kahneman</b> - The best behavioural psychology book I have read. Gives an
                                understanding on how our brains work, why we think and act the way we do, the biases we
                                have and how to be aware of them. He won the Nobel prize for this work so I guess don't
                                take my word for it.
                            </li>

                                                       <li> <b><a href="https://www.amazon.com/Cant-Hurt-Me-Master-Your-ebook/dp/B07H453KGH"
                                        target="_blank"> <i>Can't Hurt Me</i></a> by David Goggins</b> - A book
                                that leaves you thinking that you have no excuses to not push yourself to your absolute
                                limits to achieve your goals.
                            </li>

                            <li> <b><a href="https://waitbutwhy.com/" target="_blank"> <i>Wait But Why</i></a>
                                    by Tim Urban</b> - My absolute favourite blogger which inspired a lot of my style in
                                my own. He has put out series on SpaceX, Tesla and
                                Neuralink which are all awesome. He also has the most viewed <a href="https://www.youtube.com/watch?v=arj7oStGLkU"
                                target="_blank"> <i>Ted Talk</i></a>.
                            </li>

                            <!-- <li> <b><a href="https://www.amazon.com/Short-History-Nearly-Everything-ebook/dp/B000FBFNII"
                                        target="_blank"> <i>12 Rules For Life</i></a> by Jordan Peterson</b> -
                                Controversial? Eh, I love Jordan Peterson. Give him 20 minutes of non pre-biased
                                listening and I think it is quite evident that everything he hopes to achieve in life is
                                an elevated level of happiness in as many people that he can.
                            </li> -->

                            <li> <b><a href="https://www.amazon.com.au/Book-Why-Science-Cause-Effect/dp/046509760X"
                                target="_blank"> <i>The Book of Why</i></a> by Judea Pearl</b> - Great book to understand how to think causally. Must read, cannot be consumed as an audiobook, take it from me as someone who already made that mistake.
                    </li>

                        </ul>

