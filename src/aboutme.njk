                                backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
                                color: #e0e0e0; transition: opacity 150ms ease; white-space: nowrap;
                                transform: translate(-50%, -130%);"></div>
                            <p id="globe-counter" style="position: absolute; bottom: -2rem; left: 0; right: 0; text-align: center;
                                color: var(--color-text-muted); font-size: 11px; font-family: var(--font-mono, monospace);
