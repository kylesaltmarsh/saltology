<!doctype html>
<html lang="en">

<head>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="theme-color" content="#0a0a0a">
    <title>Saltology{% if title %} &mdash; {{ title }}{% endif %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
    {% if useAos %}<link rel="stylesheet" href="/css/aos.min.css">{% endif %}
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/hamburgers/hamburgers.min.css">
    <link rel="stylesheet" href="/css/animsition.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer">
    {% if useBigfoot %}<link rel="stylesheet" href="/css/bigfoot.css" type="text/css" media="all">{% endif %}
    <link rel="stylesheet" href="/css/style.css">
    <script>
      // Apply saved theme before paint to prevent flash
      (function() {
        var theme = localStorage.getItem('theme') || 'dark';
        if (theme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', '#fafafa');
        }
      })();
    </script>
    {% if useBigfoot %}
    <script type="text/javascript" src="/js/jquery-core.js"></script>
    <script type="text/javascript" src="/js/jquery-migrate.js"></script>
    {% endif %}
    <meta name="description" content="{{ description }}">
    <link rel="canonical" href="https://saltology.org{{ page.url }}">
    <meta property="og:title" content="Saltology{% if title %} - {{ title }}{% endif %}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:type" content="{{ ogType | default('website') }}">
    <meta property="og:url" content="https://saltology.org{{ page.url }}">
    <meta property="og:site_name" content="Saltology">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Saltology",
      "url": "https://saltology.org",
      "author": {
        "@type": "Person",
        "name": "Kyle Saltmarsh",
        "url": "https://www.linkedin.com/in/kylesaltmarsh/"
      }
    }
    </script>
</head>

<body>

<a href="#main-content" class="skip-link">Skip to content</a>

<div class="js-animsition animsition" data-animsition-in-class="fade-in" data-animsition-out-class="fade-out">

    <header class="templateux-navbar" data-aos="fade-down">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-9 col-9">
                    <div class="site-logo"><img src="/images/Saltologyicon_new.png" class="site-logo-img"
                            alt="Saltology logo"><a href="/"
                            class="animsition-link">saltology</a></div>
                </div>
                <div class="col-sm-3 col-3 text-right">
                    <button class="theme-toggle" type="button" aria-label="Toggle light/dark mode" title="Toggle theme">
                        <span class="icon-moon"><i class="fa-solid fa-moon"></i></span>
                        <span class="icon-sun"><i class="fa-solid fa-sun"></i></span>
                    </button>
                    <button class="hamburger hamburger--spin toggle-menu ml-auto js-toggle-menu" type="button"
                        aria-label="Toggle menu" aria-expanded="false">
                        <span class="hamburger-box">
                            <span class="hamburger-inner"></span>
                        </span>
                    </button>
                    <nav class="templateux-menu js-templateux-menu" role="navigation" aria-label="Main navigation">
                        <ul class="list-unstyled">
                            <li{% if page.url == "/about/" %} class="active"{% endif %}><a href="/about/" class="animsition-link">About Me</a></li>
                            <li{% if page.url == "/technical/" %} class="active"{% endif %}><a href="/technical/" class="animsition-link">Technical</a></li>
                            <li{% if page.url == "/" %} class="active"{% endif %}><a href="/" class="animsition-link">Home</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </header>

    <div class="header-spacer"></div>

    <main id="main-content">
    {{ content | safe }}
    </main>

    <footer class="templateux-footer">
        <div class="div-kyle">
            <div class="social-links"><a href="https://www.linkedin.com/in/kylesaltmarsh/" target="_blank" rel="noopener noreferrer" class="p-3" aria-label="LinkedIn"><span
                        class="fa-brands fa-linkedin"></span></a>
                <a href="https://www.instagram.com/kylesaltmarsh/" target="_blank" rel="noopener noreferrer" class="p-3" aria-label="Instagram"><span
                        class="fa-brands fa-instagram"></span></a>
                <a href="https://github.com/kylesaltmarsh" target="_blank" rel="noopener noreferrer" class="p-3" aria-label="GitHub"><span
                        class="fa-brands fa-github"></span></a>
            </div>
        </div>

        <div class="div-kyle">
            <div id="mc_embed_signup">
                <form action="https://live.us20.list-manage.com/subscribe/post?u=669beaecf33bd931931813b48&amp;id=75816fef41"
                    method="post" id="mc-embedded-subscribe-form" name="mc-embedded-subscribe-form" class="validate"
                    target="_blank" novalidate>
                    <div id="mc_embed_signup_scroll">
                        <label for="mce-EMAIL">Saltology - <i>(noun)</i> - The study of the interesting, informative and
                            inspiring.</label>
                        <input type="email" value="" name="EMAIL" class="email" id="mce-EMAIL"
                            placeholder="email address" required>
                        <!-- real people should not fill this in and expect good things - do not remove this or risk form bot signups-->
                        <div style="position: absolute; left: -5000px;" aria-hidden="true"><input type="text"
                                name="b_669beaecf33bd931931813b48_75816fef41" tabindex="-1" value=""></div>
                        <div class="clear"><input type="submit" value="Subscribe" name="subscribe"
                                id="mc-embedded-subscribe" class="button"></div>
                    </div>
                </form>
            </div>
        </div>

        {% if useDisqus %}
        <br>
        <div id="disqus_thread"></div>
        <script>
            (function () {
                var d = document,
                    s = d.createElement('script');
                s.src = 'https://saltology-org.disqus.com/embed.js';
                s.setAttribute('data-timestamp', +new Date());
                (d.head || d.body).appendChild(s);
            })();
        </script>
        <noscript>Please enable JavaScript to view the <a href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>
        {% endif %}
    </footer>

</div>

{% if useBigfoot %}
<script type="text/javascript" src="/js/bigfoot.js"></script>
<script type="text/javascript" src="/js/wp-bigfoot.js"></script>
{% endif %}

<script src="/js/scripts-all.js"></script>
<script src="/js/main.js"></script>

</body>
</html>
